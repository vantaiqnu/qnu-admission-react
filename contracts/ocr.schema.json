{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OCR request and result",
  "type": "object",
  "properties": {
    "language": {
      "type": "string",
      "const": "vie+eng"
    },
    "status": {
      "type": "string",
      "enum": ["queued", "processing", "completed", "failed"]
    },
    "text": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  },
  "required": ["language", "status"]
}

